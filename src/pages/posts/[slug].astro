---
import { ghostClient } from "../../lib/ghost";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await ghostClient.posts
    .browse({
      limit: "all",
    })
    .catch((err) => {
      console.error(err);
    });

  console.log("posts", posts);

  return posts.map((post) => {
    return {
      params: {
        slug: post.slug,
      },
      props: {
        post: post,
      },
    };
  });
}

const { post } = Astro.props;
---

<body>
  <Navigation />
  <div class="flex justify-center items-center min-h-screen px-4 md:px-16">
    <article
      class="prose md:prose-base lg:prose-xl w-full max-w-3xl mt-5"
    >
      <img src={post.feature_image} alt={post.title} class="mx-auto" />
      <h1>{post.title}</h1>
      <h6 class="font-bold">{post.reading_time} min read</h6>

      <Fragment set:html={post.html} />
    </article>
  </div>

  <div class="bottom-0 w-full flex justify-center p-3 bg-teal mt-10">
    <Footer />
  </div>
</body>
